# ── Anthropic ────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Search (serper.dev) ───────────────────────────────────────────────────────
SERPER_API_KEY=...

# ── Email (Resend) ────────────────────────────────────────────────────────────
RESEND_API_KEY=re_...
REPORT_EMAIL_TO=destinatario@exemplo.com
REPORT_EMAIL_FROM=relatorio@seudominio.com

# ── Logging ───────────────────────────────────────────────────────────────────
# Níveis válidos: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# ── Pipeline ──────────────────────────────────────────────────────────────────
# Máximo de itens coletados por tópico de busca
MAX_ITEMS_PER_TOPIC=3

# Caminho do arquivo JSON de cache de URLs já processadas (deduplicação)
SEEN_URLS_CACHE_PATH=outputs/seen_urls.json
